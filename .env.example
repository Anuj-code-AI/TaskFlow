APP_NAME=TaskFlow
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/taskflow
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
REFRESH_COOKIE_NAME=taskflow_refresh
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:8000
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=TaskFlow Owner
SEED_WORKSPACE_NAME=TaskFlow Workspace
SEED_PROJECT_NAME=Getting Started
